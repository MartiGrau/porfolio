---
const { index, className = "" } = Astro.props
---

<div class={`reveal mb-10 ${className}`}>
  {index && <p class="mb-2 font-mono text-sm text-violet-600 dark:text-violet-400">{index}</p>}
  <h2 class="flex items-center text-3xl font-bold tracking-tight gap-x-3 text-gray-900 dark:text-white sm:text-4xl">
    <slot />
  </h2>
</div>
