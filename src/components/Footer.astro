---
const currentYear = new Date().getFullYear()
---

<footer class="mx-auto mt-24 mb-10 w-full px-4 container lg:max-w-5xl md:max-w-2xl">
  <div class="flex flex-col gap-3 border-t border-black/5 pt-6 text-sm text-gray-500 dark:border-white/10 dark:text-gray-400 md:flex-row md:items-center md:justify-between">
    <span class="font-mono">
      &copy; {currentYear} <a href={`${import.meta.env.BASE_URL}/`} class="hover:text-violet-500">Martí Grau</a>
      <span class="text-gray-400 dark:text-gray-600">· built with Astro + a bit of AI</span>
    </span>
    <ul class="flex flex-wrap items-center gap-5 font-medium">
      <li><a href={`${import.meta.env.BASE_URL}/#about-me`} class="hover:text-violet-500">About</a></li>
      <li><a href="https://www.linkedin.com/in/martigrau96/" target="_blank" rel="noopener noreferrer" class="hover:text-violet-500">LinkedIn</a></li>
      <li><a href={`${import.meta.env.BASE_URL}/#contact`} class="hover:text-violet-500">Contact</a></li>
    </ul>
  </div>
</footer>
