---
import Layout from "@/layouts/Layout.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import TitleSection from "@/components/TitleSection.astro"
import CodeIcon from "@/components/icons/Code.astro"
---

<Layout
  title="Projects - Martí Grau"
  description="Explore the projects developed by Martí Grau, specializing in AI and Computer Vision."
>
  <main class="px-4">
    <SectionContainer id="projects" class="pt-32 pb-16 md:pt-44">
      <TitleSection index="// work in progress">
        <CodeIcon class="size-8 text-violet-500" />
        Projects
      </TitleSection>
      <div class="reveal glass spotlight flex flex-col items-center justify-center p-10 sm:p-16">
        <div class="relative mb-6">
          <div class="absolute -inset-4 rounded-full bg-gradient-to-tr from-violet-500 to-cyan-400 opacity-40 blur-xl animate-pulse"></div>
          <div class="relative flex size-16 items-center justify-center rounded-2xl bg-gradient-to-br from-violet-500 to-cyan-400 text-white shadow-lg">
            <CodeIcon class="size-8" />
          </div>
        </div>
        <p class="font-mono text-sm text-violet-600 dark:text-violet-300">training<span class="animate-blink">_</span></p>
        <h3 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">Projects coming soon</h3>
        <p class="mt-3 max-w-md text-center text-gray-600 dark:text-gray-400">
          I'm putting together my most impactful work in Generative AI, LLM agents and Computer Vision.
          Check back soon for the full showcase!
        </p>
        <div class="mt-8 h-1.5 w-full max-w-xs overflow-hidden rounded-full bg-black/5 dark:bg-white/10">
          <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-violet-500 via-cyan-400 to-emerald-400 bg-[length:200%_100%] animate-gradient-x"></div>
        </div>
      </div>
    </SectionContainer>
  </main>
</Layout>
