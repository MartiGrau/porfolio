---
import Layout from "@/layouts/Layout.astro"

import AboutMe from "@/components/AboutMe.astro"
import Briefcase from "@/components/icons/Briefcase.astro"
import Capabilities from "@/components/Capabilities.astro"
import CodeIcon from "@/components/icons/Code.astro"
import Education from "@/components/Education.astro"
import Experience from "@/components/Experience.astro"
import ProfileCheck from "@/components/icons/ProfileCheck.astro"
import SectionContainer from "@/components/SectionContainer.astro"
import Hero from "@/components/Hero.astro"
import TechStack from "@/components/TechStack.astro"
import TitleSection from "@/components/TitleSection.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import SocialPill from "@/components/SocialPill.astro"
---

<Layout
  title="Martí Grau · AI Lead at REVEL · Generative AI, LLMs & Agents"
  description="Martí Grau is AI Lead at REVEL and co-founder of StageInHome. 7+ years building generative AI: LLM agents, RAG, diffusion models and scalable MLOps on AWS."
>
  <main class="px-4">
    <SectionContainer class="pt-32 pb-20 md:pt-44 md:pb-32">
      <Hero />
    </SectionContainer>

    <div class="space-y-28 md:space-y-36">
      <SectionContainer id="skills">
        <TitleSection index="01 // what I do">
          <CodeIcon class="size-8 text-violet-500" />
          AI capabilities
        </TitleSection>
        <Capabilities />
        <div class="mt-10">
          <TechStack />
        </div>
      </SectionContainer>

      <SectionContainer id="experience">
        <TitleSection index="02 // where I've been">
          <Briefcase class="size-8 text-violet-500" />
          Experience
        </TitleSection>
        <Experience />
        <div class="mt-4">
          <Education />
        </div>
      </SectionContainer>

      <SectionContainer id="about-me">
        <TitleSection index="03 // who I am">
          <ProfileCheck class="size-8 text-violet-500" />
          About me
        </TitleSection>
        <AboutMe />
      </SectionContainer>

      <SectionContainer id="contact">
        <div class="reveal glass relative p-8 text-center sm:p-14">
          <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.25),transparent_60%)]"></div>
          <p class="font-mono text-sm text-violet-600 dark:text-violet-400">04 // let's talk</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl">
            Have an <span class="text-gradient">AI idea</span> in mind?
          </h2>
          <p class="mx-auto mt-5 max-w-xl text-lg text-gray-600 dark:text-gray-300">
            I'm always happy to talk about generative AI, agents and how to take them to production.
            Send me a message on LinkedIn!
          </p>
          <nav class="mt-8 flex flex-wrap justify-center gap-3">
            <SocialPill href="https://www.linkedin.com/in/martigrau96/">
              <LinkedInIcon class="size-4" />
              Message me on LinkedIn
            </SocialPill>
          </nav>
        </div>
      </SectionContainer>
    </div>
  </main>
</Layout>
